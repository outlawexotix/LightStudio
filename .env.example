# Gemini API Key for server-side image lighting generations (required)
GEMINI_API_KEY=

# Required in production. Use a long random value and configure the same value
# as VITE_API_ACCESS_TOKEN for a private web/Android deployment.
API_ACCESS_TOKEN=

# Server security and resource limits. Set ALLOWED_ORIGINS to the deployed web
# origin plus https://localhost for the Capacitor Android WebView.
ALLOWED_ORIGINS=https://localhost,https://your-lumina-web.example.com
ALLOWED_IMAGE_HOSTS=images.unsplash.com
ALLOWED_GEMINI_MODELS=gemini-3.1-flash-lite-image
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
MAX_IMAGE_BYTES=12582912
API_RATE_LIMIT=20
API_RATE_WINDOW_MS=60000

# Set this to the number of trusted reverse-proxy hops used by the deployment.
# Leave unset when the Node server is directly exposed.
# TRUST_PROXY_HOPS=1

# Required when building the Android app. Must be the public HTTPS origin of
# this project's deployed Express server, without a trailing slash.
VITE_API_BASE_URL=https://your-lumina-server.example.com
VITE_API_ACCESS_TOKEN=
