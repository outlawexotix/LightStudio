{
  "name": "ai-photo-light-editor",
  "description": "AI-assisted photo relighting studio for web, Android, and Windows.",
  "author": "AI Light Editor",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.9.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env.local server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:web": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:all": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node --test tests/server.integration.test.cjs",
    "test:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node --test tests/server.integration.test.cjs",
    "start": "node dist/server.cjs",
    "desktop:run": "electron .",
    "desktop:dev": "concurrently \"tsx --env-file=.env.local server.ts\" \"wait-on http://localhost:3000 && electron .\"",
    "desktop:build": "vite build --outDir dist-desktop/web --emptyOutDir && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-desktop/server.cjs && electron-builder --win",
    "android:add": "cap add android",
    "android:sync": "node scripts/validate-native-config.mjs production && vite build --mode production && cap sync android",
    "android:sync:emulator": "vite build --mode android-emulator && cap sync android",
    "android:sync:device": "vite build --mode android-device && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/share": "^7.0.2",
    "@capacitor/status-bar": "^7.0.3",
    "@google/genai": "^1.23.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "motion": "^12.42.2",
    "multer": "^2.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.ailight.editor.desktop",
    "productName": "Lumina Light Studio",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist-desktop/**/*",
      "electron/**/*",
      "package.json",
      "!android/**",
      "!node_modules/@capacitor/android/capacitor/build/**"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
